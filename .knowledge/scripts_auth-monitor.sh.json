{"is_source_file": true, "format": "bash", "description": "This is a shell script used for monitoring the expiration of Claude Code API credentials and sending notifications via openclaw, ntfy.sh, or other configured channels. It tracks credential expiry, prevents notification spam, and alerts the user proactively before credentials expire or have expired.", "external_files": ["$HOME/.claude/.credentials.json", "$HOME/.openclaw/auth-monitor-state", "$SCRIPT_DIR/claude-auth-status.sh"], "external_methods": ["jq -r", "curl", "cat", "echo", "date", "mkdir -p", "test / [ ] conditional", "grep", "openclaw send"], "published": [], "classes": [], "methods": [{"name": "send_notification", "description": "Function to send notifications via configured channels, avoiding spam by rate limiting."}], "calls": ["jq -r '.claudeAiOauth.expiresAt // 0' \"$CLAUDE_CREDS\"", "grep -q \"OK\\|EXPIRING\" \"$SCRIPT_DIR/claude-auth-status.sh\"", "openclaw send --to \"$NOTIFY_PHONE\" --message \"$message\"", "curl -s -o /dev/null -H \"Title: OpenClaw Auth Alert\" -H \"Priority: $priority\" -H \"Tags: warning,key\" -d \"$message\" \"https://ntfy.sh/$NOTIFY_NTFY\""], "search-terms": ["auth-monitor", "Claude credentials", "notification rate limiting", "credential expiry check", "cron script", "systemd timer"], "state": 2, "file_id": 5366, "knowledge_revision": 28493, "git_revision": "9a7160786a7dbd21469fad73992158e415e4686e", "hash": "1be257dd2104eec58ad8f54186487620", "format-version": 4, "code-base-name": "openclaw-339114", "filename": "scripts/auth-monitor.sh", "revision_history": [{"28493": "9a7160786a7dbd21469fad73992158e415e4686e"}]}
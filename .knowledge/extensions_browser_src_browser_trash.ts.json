{"is_source_file": true, "format": "TypeScript", "description": "This source file defines an asynchronous function 'movePathToTrash' that attempts to move a specified file or directory to the system's trash. It first tries to execute an external 'trash' command, and if that fails, it falls back to manually moving the file to a '.Trash' directory within the user's home directory, creating the directory if necessary. The function handles naming conflicts by appending timestamps and a secure token.", "external_files": ["../infra/secure-random.js", "../process/exec.js"], "external_methods": ["generateSecureToken", "runExec"], "published": ["movePathToTrash"], "classes": [], "methods": [{"name": "export async function movePathToTrash(targetPath: string): Promise<string> { movePathToTrash", "description": "Asynchronously moves a given path to the system's trash, preferring a system 'trash' command and falling back to a manual move into a '.Trash' directory, handling naming conflicts with timestamps and a secure token.", "scope": "", "scopeKind": ""}], "calls": ["runExec(\"trash\", [targetPath], { timeoutMs: 10_000 })", "path.join(os.homedir(), \".Trash\")", "fs.mkdirSync(trashDir, { recursive: true })", "path.basename(targetPath)", "path.join(trashDir, `${base}-${Date.now()}`)", "fs.existsSync(dest)", "generateSecureToken(6)", "fs.renameSync(targetPath, dest)"], "search-terms": ["movePathToTrash", "trash directory", "fallback to manual move", "secure token", "trash command"], "state": 2, "file_id": 10033, "knowledge_revision": 33089, "git_revision": "8eeb7f0829754cb3446a3bc7279fbf48d38edd3c", "ctags": [{"_type": "tag", "name": "base", "path": "/home/kavia/workspace/code-generation/openclaw-339114/extensions/browser/src/browser/trash.ts", "pattern": "/^    const base = path.basename(targetPath);$/", "language": "TypeScript", "kind": "constant", "scope": "movePathToTrash", "scopeKind": "function"}, {"_type": "tag", "name": "movePathToTrash", "path": "/home/kavia/workspace/c
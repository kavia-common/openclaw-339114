{"is_source_file": true, "format": "bash script", "description": "This script initializes a headless Chrome/Chromium environment with options for debugging, graphics disabling, extension management, and VNC forwarding setup. It setups environment variables, launches Xvfb, configures Chrome arguments dynamically based on environment options, waits for the debugging interface to be ready, and potentially starts VNC services for remote access.", "external_files": ["/proc/sys/kernel/random/uuid", "/usr/share/novnc/", "x11vnc", "websockify", "chromium"], "external_methods": ["curl", "socat", "x11vnc -storepasswd", "x11vnc", "websockify"], "published": [], "classes": [], "methods": [{"name": "dedupe_chrome_args", "description": "Removes duplicate entries from the CHROME_ARGS array to ensure unique arguments are passed to Chromium."}], "calls": ["curl -sS --max-time 1 \"http://127.0.0.1:${CHROME_CDP_PORT}/json/version\"", "sleep 0.1", "socat \"${SOCAT_LISTEN_ADDR}\" \"TCP:127.0.0.1:${CHROME_CDP_PORT}\"", "x11vnc -storepasswd \"${NOVNC_PASSWORD}\" \"${NOVNC_PASSWD_FILE}\"", "x11vnc -display :1 -rfbport \"${VNC_PORT}\" -shared -forever -rfbauth \"${NOVNC_PASSWD_FILE}\" -localhost", "websockify --web /usr/share/novnc/ \"${NOVNC_PORT}\" \"localhost:${VNC_PORT}\"", "chromium \"${CHROME_ARGS[@]}\" about:blank"], "search-terms": ["sandbox-browser-entrypoint.sh", "chrome args configuration", "headless Chrome setup", "VNC setup", "Xvfb", "socat TCP forwarding", "Chrome debugging port", "environment variable configuration"], "state": 2, "file_id": 7712, "knowledge_revision": 30796, "git_revision": "6b9915a1064d9cf871eaec23944458ac65cc38f1", "hash": "b4fc9a5a88f1ca1f5d823be2fe4e049c", "format-version": 4, "code-base-name": "openclaw-339114", "filename": "scripts/sandbox-browser-entrypoint.sh", "revision_history": [{"30796": "6b9915a1064d9cf871eaec23944458ac65cc38f1"}]}